# ============================================
# ParkPoint Solutions - Docker Environment
# ============================================
# Usar con: docker compose --env-file .env.docker up -d
# ============================================

# ---- Generales ----
NODE_ENV=development

# ---- PostgreSQL (Docker container) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=PARQUEO_INTELIGENTE_DB
DB_USERNAME=root
DB_PASSWORD=
DB_SQL_LOGGING=false

# ---- MongoDB Atlas ----
MONGODB_URI=
MONGODB_DB_NAME=Parqueo_Inteligente

# ---- URLs entre servicios (nombres de contenedor Docker) ----
AUTH_SERVICE_URL=http://auth-service:4001
PARKING_SERVICE_URL=http://parking-service:4002
PRICING_SERVICE_URL=http://pricing-service:4003
FAVORITES_SERVICE_URL=http://favorites-service:4004
REPORTS_SERVICE_URL=http://reports-service:4005

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRES_IN=30m
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# ---- Brevo (Transactional Email) ----
BREVO_API_KEY=
BREVO_FROM_EMAIL=miguelhillofuentes223@gmail.com
BREVO_FROM_NAME=ParkPoint

# ---- Cloudinary (AuthService) ----
CLOUDINARY_CLOUD_NAME=dma7p3txk
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_URL=https://res.cloudinary.com/dma7p3txk/image/upload/
CLOUDINARY_FOLDER=gestor-opiniones/profiles
CLOUDINARY_DEFAULT_AVATAR_FILENAME=default-avatar_ewzxwx.png

# ---- Stripe (ParkingService) ----
STRIPE_SECRET_KEY=

# ---- Pricing (ParkingService, PricingService) ----
DEFAULT_BASE_PRICE_CENTS=500
PRICING_HIGH_MULTIPLIER=1.5
PRICING_LOW_MULTIPLIER=0.8
PRICING_HIGH_THRESHOLD=0.8
PRICING_LOW_THRESHOLD=0.3

# ---- Frontend / Admin ----
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://api-gateway:4000
SUPER_ADMIN_EMAIL=josuealvarez1220@gmail.com
