NODE_ENV=development
PORT=4002

# PostgreSQL
DB_HOST=localhost
DB_PORT=5436
DB_NAME=PARQUEO_INTELIGENTE_DB
DB_USERNAME=root
DB_PASSWORD=admin
DB_SQL_LOGGING=false

# MongoDB
# Local (Docker):
#   MONGODB_URI=mongodb://localhost:27017/Parqueo_Inteligente
# Atlas (produccion):
#   MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=ParkPointSolutions
# Atlas, cadena estandar (usar si Node falla con "querySrv ECONNREFUSED"):
#   MONGODB_URI=mongodb://<usuario>:<password>@<nodo-00>:27017,<nodo-01>:27017,<nodo-02>:27017/?ssl=true&replicaSet=<replicaSet>&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/Parqueo_Inteligente
MONGODB_DB_NAME=Parqueo_Inteligente

# Solo para el script scripts/migrate-to-atlas.js (origen de la migracion)
MONGODB_SOURCE_URI=mongodb://localhost:27017/Parqueo_Inteligente

# JWT
JWT_SECRET=cambia_esta_clave
JWT_EXPIRES_IN=30m
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# Brevo (Transactional Email)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ParkPoint

# Stripe
STRIPE_SECRET_KEY=

# Pricing
DEFAULT_BASE_PRICE_CENTS=500
PRICING_HIGH_MULTIPLIER=1.5
PRICING_LOW_MULTIPLIER=0.8
PRICING_HIGH_THRESHOLD=0.8
PRICING_LOW_THRESHOLD=0.3

SUPER_ADMIN_EMAIL=
