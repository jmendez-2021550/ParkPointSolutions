NODE_ENV=production
PORT=4002

# PostgreSQL
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=<db-name>

# JWT
JWT_SECRET=<your-jwt-secret>
JWT_EXPIRES_IN=30m
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# Brevo (Transactional Email)
BREVO_API_KEY=<brevo-api-key>
BREVO_FROM_EMAIL=<from-email>
BREVO_FROM_NAME=ParkPoint

# Stripe
STRIPE_SECRET_KEY=<stripe-secret-key>

# Pricing
DEFAULT_BASE_PRICE_CENTS=500
PRICING_HIGH_MULTIPLIER=1.5
PRICING_LOW_MULTIPLIER=0.8
PRICING_HIGH_THRESHOLD=0.8
PRICING_LOW_THRESHOLD=0.3

SUPER_ADMIN_EMAIL=<admin-email>
